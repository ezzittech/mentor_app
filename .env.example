# Copy to .env and fill with your Supabase project values
# (Supabase Dashboard → Project Settings → API). The anon / publishable key is public by design;
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# "false" hides the demo portal previews on the login page (recommended in production)
VITE_DEMO_MODE=true
